PORT=3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Public HTTPS URL in production for origin checks.
APP_ORIGIN=http://localhost:3000

# Keep Node behind Nginx. For local use, leave TRUST_PROXY=none.
HOST=127.0.0.1
TRUST_PROXY=none
# On this production server, Nginx overwrites X-Real-IP from a loopback connection:
# TRUST_PROXY=loopback

# Wompi: integración inicial exclusivamente en pruebas.
WOMPI_MODE=disabled
# Cambiar a sandbox después de configurar las cuatro claves sandbox de Bacatá.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
